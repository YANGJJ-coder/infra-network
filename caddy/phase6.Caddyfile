# Phase 6 overlay.  This block is appended to the existing reverse-proxy
# Caddyfile; it does not alter sub.jijunyang.com or its /sub/* handler.
status.jijunyang.com {
    encode zstd gzip

    @server_summary path /api/server-summary
    handle @server_summary {
        header Cache-Control "public, max-age=60"
        reverse_proxy http://127.0.0.1:3010 {
            transport http {
                read_timeout 5s
            }
        }
    }

    @status_home path /
    handle @status_home {
        reverse_proxy http://127.0.0.1:3010
    }

    handle {
        reverse_proxy http://127.0.0.1:3001 {
            transport http {
                read_timeout 30s
            }
        }
    }
}
