sub.jijunyang.com {
    log {
        output file /var/log/caddy/access.log
        format json
    }

    @subscription path /sub/*
    log_skip @subscription

    @generated path __CONFIG_GENERATOR_PATH__
    log_skip @generated

    handle @subscription {
        reverse_proxy http://127.0.0.1:2096
    }

    handle_path __CONFIG_GENERATOR_PATH__ {
        reverse_proxy http://127.0.0.1:3011
    }

    @iphone_slim path __IPHONE_SLIM_PATH__
    log_skip @iphone_slim
    handle @iphone_slim {
        reverse_proxy http://127.0.0.1:3011
    }

    handle __IOS_TEMPLATE_PATH__ {
        reverse_proxy http://127.0.0.1:3011
    }

    # Rule providers are fetched through the same HTTPS origin as the private
    # configuration, so first-run mobile clients do not depend on GitHub.
    handle /rules/* {
        reverse_proxy http://127.0.0.1:3011
    }

    handle {
        respond "Not Found" 404
    }
}

# Keep the Phase 6 status endpoint on the same Caddy instance.  This is
# intentionally a separate vhost: the generated subscription path above must
# not replace or absorb the status service routes.
status.jijunyang.com {
    encode zstd gzip

    @custom_rules_root path /manage-status-page/custom-rules
    redir @custom_rules_root /manage-status-page/custom-rules/ 308

    handle_path /manage-status-page/custom-rules/* {
        import /etc/caddy/custom-rules-auth.caddy
        reverse_proxy http://127.0.0.1:3012 {
            transport http {
                read_timeout 30s
            }
        }
    }

    @server_summary path /api/server-summary
    handle @server_summary {
        header Cache-Control "public, max-age=60"
        reverse_proxy http://127.0.0.1:3010 {
            transport http {
                read_timeout 5s
            }
        }
    }

    @status_home path /
    handle @status_home {
        reverse_proxy http://127.0.0.1:3010
    }

    handle {
        reverse_proxy http://127.0.0.1:3001 {
            transport http {
                read_timeout 30s
            }
        }
    }
}
